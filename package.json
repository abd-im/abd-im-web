{
  "name": "abd-im",
  "productName": "ABD IM",
  "version": "1.0.0",
  "main": "dist-electron/main/index.js",
  "description": "ABD IM desktop client.",
  "author": "blooming",
  "private": true,
  "debug": {
    "env": {
      "VITE_DEV_SERVER_URL": "http://127.0.0.1:7777/"
    }
  },
  "scripts": {
    "dev": "vite --force --host",
    "dev:web": "cross-env BUILD_TARGET=web vite --force --host",
    "build": "vite build",
    "build:win": "vite build && electron-builder --win --x64",
    "build:web": "cross-env BUILD_TARGET=web vite build",
    "check:electron": "tsc --noEmit -p tsconfig.node.json",
    "preview": "vite preview",
    "test": "vitest run",
    "pree2e": "vite build --mode=test",
    "e2e": "playwright test",
    "format": "prettier --write .",
    "lint": "eslint --ext .js,.jsx,.ts,.tsx src",
    "lint:fix": "eslint --ext .js,.jsx,.ts,.tsx --fix --quiet src",
    "prepare": "husky install",
    "postinstall": "patch-package"
  },
  "devDependencies": {
    "@commitlint/cli": "^17.8.1",
    "@commitlint/config-conventional": "^17.8.1",
    "@playwright/test": "^1.62.1",
    "@types/md5": "^2.3.6",
    "@types/node": "24.13.3",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/uuid": "^9.0.8",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "@vitejs/plugin-react": "^3.1.0",
    "autoprefixer": "^10.5.4",
    "cross-env": "7.0.3",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^8.10.2",
    "eslint-plugin-prettier": "^4.2.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-simple-import-sort": "^10.0.0",
    "husky": "^8.0.3",
    "lint-staged": "^13.3.0",
    "patch-package": "^8.0.1",
    "postcss": "^8.5.26",
    "postcss-nesting": "^12.1.5",
    "prettier": "^2.8.8",
    "prettier-plugin-tailwindcss": "^0.2.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sass": "^1.102.0",
    "tailwindcss": "^3.4.19",
    "typescript": "^4.9.5",
    "vite": "^4.5.14",
    "vite-electron-plugin": "^0.8.3",
    "vitest": "^0.34.6"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "lint-staged": {
    "src/**/*.{tsx,ts}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,html,css,scss,xml,md}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@abd-im/wasm-client-sdk": "3.8.3-patch.17",
    "@ant-design/icons": "^5.6.1",
    "@ckeditor/ckeditor5-react": "^8.0.0",
    "@livekit/components-react": "2.6.9",
    "@livekit/components-styles": "1.1.4",
    "ahooks": "^3.9.7",
    "antd": "5.10.0",
    "axios": "^1.19.0",
    "ckeditor5": "^43.3.1",
    "clsx": "^1.2.1",
    "date-fns": "^2.30.0",
    "dayjs": "^1.11.21",
    "electron-log": "^5.4.4",
    "electron-store": "^8.2.0",
    "emoji-picker-element": "1.21.3",
    "i18next": "^22.5.1",
    "i18next-browser-languagedetector": "^7.2.2",
    "livekit-client": "2.7.0",
    "localforage": "^1.10.0",
    "lucide-react": "0.468.0",
    "md5": "^2.3.0",
    "mitt": "^3.0.1",
    "react-draggable": "4.5.0",
    "react-i18next": "^12.3.1",
    "react-image-file-resizer": "^0.4.8",
    "react-markdown": "9.1.0",
    "react-query": "^3.39.3",
    "react-resizable-panels": "^2.1.9",
    "react-router-dom": "^6.30.4",
    "react-use": "^17.6.1",
    "react-virtuoso": "4.3.8",
    "twemoji": "14.0.1",
    "uuid": "^9.0.1",
    "xgplayer": "^3.0.26",
    "zustand": "^4.5.7"
  }
}
